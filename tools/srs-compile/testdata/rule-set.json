{
  "version": 3,
  "rules": [
    {
      "domain": [
        "example.com"
      ],
      "domain_suffix": [
        "example.org"
      ],
      "domain_keyword": [
        "cdn"
      ],
      "domain_regex": [
        "^api\\."
      ],
      "ip_cidr": [
        "192.0.2.0/24",
        "2001:db8::/32"
      ]
    },
    {
      "process_name": [
        "demo"
      ]
    },
    {
      "type": "logical",
      "mode": "and",
      "rules": [
        {
          "domain_suffix": [
            "internal.example"
          ]
        },
        {
          "domain_keyword": [
            "secure"
          ],
          "invert": true
        }
      ]
    }
  ]
}
